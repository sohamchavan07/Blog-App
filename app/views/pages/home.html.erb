<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BlogApp — Write What Matters</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --ink:       #0d0d0d;
    --ink-2:     #3a3530;
    --ink-3:     #7a6f66;
    --cream:     #f7f3ed;
    --cream-2:   #efe9df;
    --gold:      #6366f1; /* updated to theme color */
    --gold-light:#818cf8; /* updated to theme color light */
    --white:     #ffffff;
    --serif:     'Cormorant Garamond', Georgia, serif;
    --sans:      'DM Sans', sans-serif;
    --ease-out:  cubic-bezier(0.22, 1, 0.36, 1);
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--sans);
    background: var(--cream);
    color: var(--ink);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* ── NAV ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 5vw;
    height: 68px;
    background: rgba(247, 243, 237, 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(99, 102, 241, 0.18);
  }

  .nav-logo {
    font-family: var(--serif);
    font-size: 1.6rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: var(--ink);
    text-decoration: none;
    display: flex; align-items: center; gap: 8px;
  }
  .nav-logo span { color: var(--gold); }

  .nav-links {
    display: flex; align-items: center; gap: 36px;
    list-style: none;
  }
  .nav-links a {
    font-size: 0.8rem; font-weight: 400; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--ink-2);
    text-decoration: none; transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--gold); }

  .nav-cta {
    display: flex; gap: 12px; align-items: center;
  }

  /* ── BUTTONS ── */
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--sans); font-size: 0.78rem;
    font-weight: 500; letter-spacing: 0.1em;
    text-transform: uppercase; text-decoration: none;
    border: none; cursor: pointer;
    transition: all 0.25s var(--ease-out);
    white-space: nowrap;
  }

  .btn-ghost {
    background: transparent; color: var(--ink-2);
    padding: 10px 20px;
    border: 1px solid rgba(58,53,48,0.25);
    border-radius: 2px;
  }
  .btn-ghost:hover {
    border-color: var(--gold); color: var(--gold);
  }

  .btn-primary {
    background: var(--ink); color: var(--cream);
    padding: 12px 28px; border-radius: 2px;
  }
  .btn-primary:hover {
    background: var(--gold); color: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 8px 30px rgba(99, 102, 241,0.3);
  }

  .btn-large {
    font-size: 0.85rem;
    padding: 16px 40px;
    border-radius: 2px;
  }

  .btn-outline-cream {
    background: transparent;
    color: var(--cream);
    border: 1px solid rgba(247,243,237,0.4);
    padding: 16px 40px; border-radius: 2px;
  }
  .btn-outline-cream:hover {
    border-color: var(--gold-light); color: var(--gold-light);
    transform: translateY(-1px);
  }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-top: 68px;
  }

  .hero-left {
    display: flex; flex-direction: column; justify-content: center;
    padding: 80px 5vw 80px 5vw;
    position: relative;
  }

  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 0.72rem; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--gold);
    margin-bottom: 28px;
    animation: fadeUp 0.8s var(--ease-out) 0.1s both;
  }
  .eyebrow-line {
    width: 32px; height: 1px; background: var(--gold);
  }

  .hero-title {
    font-family: var(--serif);
    font-size: clamp(3.2rem, 5.5vw, 6rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 28px;
    animation: fadeUp 0.8s var(--ease-out) 0.2s both;
  }
  .hero-title em {
    font-style: italic; color: var(--gold);
  }

  .hero-body {
    font-size: 1.05rem; font-weight: 300;
    line-height: 1.75; color: var(--ink-3);
    max-width: 460px; margin-bottom: 44px;
    animation: fadeUp 0.8s var(--ease-out) 0.3s both;
  }

  .hero-actions {
    display: flex; gap: 14px; flex-wrap: wrap;
    animation: fadeUp 0.8s var(--ease-out) 0.4s both;
  }

  .hero-stat-row {
    display: flex; gap: 40px; margin-top: 60px;
    padding-top: 44px;
    border-top: 1px solid rgba(58,53,48,0.1);
    animation: fadeUp 0.8s var(--ease-out) 0.5s both;
  }

  .hero-stat {
    display: flex; flex-direction: column; gap: 4px;
  }
  .stat-num {
    font-family: var(--serif); font-size: 2.2rem;
    font-weight: 300; color: var(--ink);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.72rem; font-weight: 400;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink-3);
  }

  /* Hero Right – editorial stack */
  .hero-right {
    background: var(--ink);
    position: relative;
    overflow: hidden;
    display: flex; flex-direction: column;
    justify-content: flex-end;
    padding: 60px 5vw;
    animation: fadeIn 1s var(--ease-out) 0.3s both;
  }

  .hero-right::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 70% 20%, rgba(99, 102, 241,0.14) 0%, transparent 70%),
      radial-gradient(ellipse 40% 60% at 20% 80%, rgba(99, 102, 241,0.08) 0%, transparent 60%);
  }

  .hero-quote-deco {
    position: absolute; top: 60px; right: 5vw;
    font-family: var(--serif); font-size: 18rem;
    line-height: 1; color: rgba(99, 102, 241,0.06);
    user-select: none; pointer-events: none;
    font-weight: 600;
  }

  .featured-cards {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; gap: 2px;
  }

  .f-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.07);
    padding: 24px 28px;
    cursor: pointer;
    transition: all 0.3s var(--ease-out);
    animation: slideRight 0.7s var(--ease-out) calc(0.4s + var(--i, 0) * 0.1s) both;
  }
  .f-card:hover {
    background: rgba(99, 102, 241,0.08);
    border-color: rgba(99, 102, 241,0.3);
    transform: translateX(-6px);
  }

  .f-card-tag {
    font-size: 0.68rem; font-weight: 500; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--gold);
    margin-bottom: 8px;
  }
  .f-card-title {
    font-family: var(--serif); font-size: 1.2rem;
    font-weight: 400; color: rgba(247,243,237,0.9);
    line-height: 1.35; margin-bottom: 10px;
  }
  .f-card-meta {
    display: flex; align-items: center; gap: 14px;
  }
  .f-card-avatar {
    width: 26px; height: 26px; border-radius: 50%;
    background: linear-gradient(135deg, var(--gold), var(--ink-2));
    display: flex; align-items: center; justify-content: center;
    font-size: 0.6rem; font-weight: 600; color: var(--cream);
  }
  .f-card-author {
    font-size: 0.75rem; color: rgba(247,243,237,0.45);
  }
  .f-card-read {
    margin-left: auto;
    font-size: 0.68rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: rgba(99, 102, 241,0.6);
  }

  /* ── LOGO BANNER ── */
  .logo-banner {
    border-top: 1px solid rgba(58,53,48,0.1);
    border-bottom: 1px solid rgba(58,53,48,0.1);
    padding: 26px 5vw;
    display: flex; align-items: center; gap: 40px;
    overflow: hidden;
  }
  .banner-label {
    font-size: 0.68rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--ink-3);
    white-space: nowrap; flex-shrink: 0;
  }
  .banner-divider {
    width: 1px; height: 20px; background: rgba(58,53,48,0.2); flex-shrink: 0;
  }
  .marquee-track {
    display: flex; gap: 56px; align-items: center;
    animation: marquee 18s linear infinite;
    flex-shrink: 0;
  }
  .marquee-wrapper {
    display: flex; gap: 56px; overflow: hidden; flex: 1;
  }
  .marquee-word {
    font-family: var(--serif); font-size: 1.1rem;
    font-weight: 300; font-style: italic;
    color: var(--ink-3); white-space: nowrap; opacity: 0.6;
  }

  /* ── FEATURES ── */
  .features {
    padding: 120px 5vw;
  }

  .section-header {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 40px; align-items: end;
    margin-bottom: 80px;
  }

  .section-tag {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 0.72rem; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--gold);
    margin-bottom: 20px;
  }

  .section-title {
    font-family: var(--serif);
    font-size: clamp(2.4rem, 3.5vw, 4rem);
    font-weight: 300; line-height: 1.1;
    color: var(--ink);
  }
  .section-title em { font-style: italic; color: var(--gold); }

  .section-desc {
    font-size: 1rem; font-weight: 300; line-height: 1.8;
    color: var(--ink-3); max-width: 400px;
    margin-top: auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border: 1px solid rgba(58,53,48,0.1);
    background: rgba(58,53,48,0.1);
  }

  .feat-card {
    background: var(--cream);
    padding: 48px 40px;
    transition: background 0.3s var(--ease-out);
    position: relative; overflow: hidden;
  }
  .feat-card:hover { background: var(--cream-2); }
  .feat-card:hover .feat-num { opacity: 0.08; transform: scale(1.1); }

  .feat-num {
    position: absolute; top: 20px; right: 24px;
    font-family: var(--serif); font-size: 5rem;
    font-weight: 600; color: var(--ink); opacity: 0.04;
    line-height: 1; user-select: none;
    transition: all 0.4s var(--ease-out);
  }

  .feat-icon {
    width: 44px; height: 44px;
    border: 1px solid rgba(99, 102, 241,0.3);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 28px;
    transition: border-color 0.3s, background 0.3s;
  }
  .feat-card:hover .feat-icon {
    border-color: var(--gold);
    background: rgba(99, 102, 241,0.08);
  }
  .feat-icon svg {
    width: 18px; height: 18px; stroke: var(--gold);
    stroke-width: 1.5; fill: none;
  }

  .feat-title {
    font-family: var(--serif); font-size: 1.35rem;
    font-weight: 400; line-height: 1.25;
    color: var(--ink); margin-bottom: 14px;
  }
  .feat-text {
    font-size: 0.88rem; font-weight: 300;
    line-height: 1.75; color: var(--ink-3);
  }

  /* ── QUOTE / EDITORIAL STRIP ── */
  .editorial-strip {
    background: var(--ink);
    padding: 100px 5vw;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 80px; align-items: center;
    position: relative; overflow: hidden;
  }
  .editorial-strip::after {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 50% 80% at 100% 50%, rgba(99, 102, 241,0.07) 0%, transparent 60%);
  }

  .strip-label {
    font-size: 0.72rem; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--gold);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    opacity: 0.8;
  }

  .strip-quote {
    position: relative; z-index: 1;
  }
  .big-quote-mark {
    font-family: var(--serif); font-size: 8rem;
    line-height: 0.6; color: var(--gold);
    opacity: 0.4; display: block; margin-bottom: 20px;
    font-weight: 600;
  }
  .strip-quote blockquote {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 2.5vw, 2.6rem);
    font-weight: 300; font-style: italic;
    line-height: 1.45; color: rgba(247,243,237,0.88);
    margin-bottom: 32px;
  }
  .strip-attribution {
    display: flex; align-items: center; gap: 16px;
  }
  .attr-line {
    width: 32px; height: 1px; background: var(--gold); opacity: 0.5;
  }
  .attr-text {
    font-size: 0.78rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: rgba(99, 102, 241,0.7);
  }

  /* ── MEMBERSHIP / PRICING ── */
  .membership {
    padding: 120px 5vw;
    background: var(--cream-2);
  }

  .membership-header {
    text-align: center; margin-bottom: 72px;
  }
  .membership-header .section-title { margin: 0 auto; }

  .pricing-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 2px; max-width: 900px; margin: 0 auto;
    border: 1px solid rgba(58,53,48,0.12);
    background: rgba(58,53,48,0.12);
  }

  .price-card {
    background: var(--cream);
    padding: 48px 36px;
    position: relative;
  }
  .price-card.featured {
    background: var(--ink);
  }

  .price-badge {
    display: inline-block;
    font-size: 0.65rem; font-weight: 500; letter-spacing: 0.18em;
    text-transform: uppercase;
    background: var(--gold); color: var(--ink);
    padding: 4px 12px; margin-bottom: 28px;
    border-radius: 1px;
  }

  .price-tier {
    font-size: 0.72rem; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--ink-3);
    margin-bottom: 12px;
  }
  .price-card.featured .price-tier { color: rgba(99, 102, 241,0.7); }

  .price-amount {
    font-family: var(--serif); font-size: 3.5rem;
    font-weight: 300; line-height: 1; color: var(--ink);
    margin-bottom: 6px;
  }
  .price-card.featured .price-amount { color: var(--cream); }
  .price-amount sup {
    font-size: 1.4rem; vertical-align: super;
  }
  .price-period {
    font-size: 0.78rem; color: var(--ink-3); margin-bottom: 32px;
  }
  .price-card.featured .price-period { color: rgba(247,243,237,0.4); }

  .price-divider {
    height: 1px; background: rgba(58,53,48,0.1); margin-bottom: 32px;
  }
  .price-card.featured .price-divider { background: rgba(255,255,255,0.08); }

  .price-features {
    list-style: none; display: flex; flex-direction: column; gap: 14px;
    margin-bottom: 40px;
  }
  .price-features li {
    display: flex; align-items: center; gap: 10px;
    font-size: 0.875rem; font-weight: 300; color: var(--ink-2);
  }
  .price-card.featured .price-features li { color: rgba(247,243,237,0.75); }
  .price-features li::before {
    content: '';
    width: 16px; height: 16px; flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid rgba(99, 102, 241,0.4);
    background: url("data:image/svg+xml,%3Csvg width='10' height='8' viewBox='0 0 10 8' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4L3.5 6.5L9 1' stroke='%236366f1' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E") center/10px no-repeat;
  }

  .btn-full { width: 100%; justify-content: center; }

  .btn-ink {
    background: var(--cream); color: var(--ink);
    padding: 14px 28px; border-radius: 2px;
    font-size: 0.78rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase;
    text-decoration: none; display: flex; align-items: center; justify-content: center;
    transition: all 0.25s var(--ease-out);
    border: none; cursor: pointer;
  }
  .btn-ink:hover {
    background: var(--gold); color: var(--ink);
    transform: translateY(-1px);
    box-shadow: 0 8px 30px rgba(99, 102, 241,0.4);
  }

  .btn-border {
    background: transparent; color: var(--ink);
    border: 1px solid rgba(58,53,48,0.25);
    padding: 14px 28px; border-radius: 2px;
    font-size: 0.78rem; font-weight: 500;
    letter-spacing: 0.1em; text-transform: uppercase;
    text-decoration: none; display: flex; align-items: center; justify-content: center;
    transition: all 0.25s var(--ease-out);
    cursor: pointer;
  }
  .btn-border:hover { border-color: var(--gold); color: var(--gold); }

  /* ── CTA ── */
  .cta-section {
    background: linear-gradient(135deg, var(--ink) 0%, #1a1610 100%);
    padding: 140px 5vw;
    text-align: center;
    position: relative; overflow: hidden;
  }
  .cta-section::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 60% 60% at 50% 0%, rgba(99, 102, 241,0.12) 0%, transparent 60%),
      radial-gradient(ellipse 40% 40% at 10% 100%, rgba(99, 102, 241,0.06) 0%, transparent 50%);
  }

  .cta-inner {
    position: relative; z-index: 1; max-width: 640px; margin: 0 auto;
  }

  .cta-eyebrow {
    font-size: 0.72rem; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; color: var(--gold);
    margin-bottom: 24px; display: block;
  }

  .cta-title {
    font-family: var(--serif);
    font-size: clamp(2.8rem, 4.5vw, 5rem);
    font-weight: 300; line-height: 1.08;
    color: var(--cream); margin-bottom: 24px;
  }
  .cta-title em { font-style: italic; color: var(--gold); }

  .cta-body {
    font-size: 1rem; font-weight: 300; line-height: 1.8;
    color: rgba(247,243,237,0.55); margin-bottom: 48px;
  }

  .cta-actions {
    display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;
  }

  .cta-footnote {
    margin-top: 28px; font-size: 0.75rem;
    color: rgba(247,243,237,0.25); letter-spacing: 0.05em;
  }

  /* ── FOOTER ── */
  footer {
    background: var(--ink);
    border-top: 1px solid rgba(255,255,255,0.05);
    padding: 60px 5vw 36px;
  }

  .footer-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    margin-bottom: 36px;
  }

  .footer-brand {
    font-family: var(--serif); font-size: 1.8rem;
    font-weight: 300; letter-spacing: 0.08em;
    color: var(--cream);
  }
  .footer-brand span { color: var(--gold); }

  .footer-tagline {
    font-size: 0.8rem; color: rgba(247,243,237,0.3);
    margin-top: 8px; font-style: italic;
    font-family: var(--serif);
  }

  .footer-links-group {
    display: flex; gap: 64px;
  }

  .footer-col-title {
    font-size: 0.68rem; font-weight: 500; letter-spacing: 0.2em;
    text-transform: uppercase; color: rgba(99, 102, 241,0.7);
    margin-bottom: 18px;
  }

  .footer-col-links {
    list-style: none; display: flex; flex-direction: column; gap: 10px;
  }
  .footer-col-links a {
    font-size: 0.82rem; font-weight: 300;
    color: rgba(247,243,237,0.4);
    text-decoration: none; transition: color 0.2s;
  }
  .footer-col-links a:hover { color: var(--cream); }

  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center;
  }
  .footer-copy {
    font-size: 0.75rem; color: rgba(247,243,237,0.2);
    letter-spacing: 0.05em;
  }
  .footer-legal {
    display: flex; gap: 24px;
  }
  .footer-legal a {
    font-size: 0.75rem; color: rgba(247,243,237,0.2);
    text-decoration: none; transition: color 0.2s;
  }
  .footer-legal a:hover { color: rgba(247,243,237,0.5); }

  /* ── ANIMATIONS ── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes slideRight {
    from { opacity: 0; transform: translateX(30px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Nav button_to form fix – keep Sign Out inline with other nav items */
  .nav-cta form {
    display: inline-flex;
    margin: 0;
    padding: 0;
  }
  .nav-cta form .btn {
    margin: 0;
  }
  @media (max-width: 1024px) {
    .hero { grid-template-columns: 1fr; }
    .hero-right { min-height: 480px; }
    .features-grid { grid-template-columns: repeat(2, 1fr); }
    .pricing-grid { grid-template-columns: 1fr; max-width: 420px; }
    .section-header { grid-template-columns: 1fr; }
    .editorial-strip { grid-template-columns: 1fr; }
    .strip-label { writing-mode: horizontal-tb; transform: none; }
    .footer-top { flex-direction: column; gap: 40px; }
    .footer-links-group { gap: 40px; }
  }

  @media (max-width: 640px) {
    .features-grid { grid-template-columns: 1fr; }
    nav .nav-links { display: none; }
    .hero-actions { flex-direction: column; }
    .hero-stat-row { gap: 24px; }
    .cta-actions { flex-direction: column; align-items: center; }
    .footer-links-group { flex-direction: column; gap: 32px; }
    .footer-bottom { flex-direction: column; gap: 16px; text-align: center; }
  }
</style>

