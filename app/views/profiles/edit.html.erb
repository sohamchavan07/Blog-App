<div class="profile-container" style="max-width: 600px; margin: 0 auto; padding: 2rem; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);">
  <h1 style="margin-bottom: 2rem;">Edit Profile</h1>

  <%= form_with model: @user, url: profile_path, local: true, html: { multipart: true, style: "display: flex; flex-direction: column; gap: 1.5rem;" } do |f| %>
    <% if @user.errors.any? %>
      <div style="background: #fee2e2; color: #b91c1c; padding: 1rem; border-radius: 4px;">
        <h4 style="margin-top: 0;"><%= pluralize(@user.errors.count, "error") %> prohibited this profile from being saved:</h4>
        <ul style="margin-bottom: 0;">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
        </ul>
      </div>
    <% end %>

    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <%= f.label :avatar, "Profile Picture" %>
      <%= f.file_field :avatar, accept: 'image/*', style: "padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 4px;" %>
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <%= f.label :full_name %>
      <%= f.text_field :full_name, class: "form-input", style: "padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 4px;" %>
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <%= f.label :bio %>
      <%= f.text_area :bio, rows: 4, class: "form-input", style: "padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 4px;" %>
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <%= f.label :github_username, "GitHub Username" %>
      <%= f.text_field :github_username, class: "form-input", style: "padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 4px;" %>
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <%= f.label :twitter_handle, "Twitter Handle" %>
      <%= f.text_field :twitter_handle, class: "form-input", style: "padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 4px;" %>
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      <%= f.label :linkedin_url, "LinkedIn Profile URL" %>
      <%= f.url_field :linkedin_url, class: "form-input", style: "padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 4px;" %>
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 1rem;">
      <%= f.submit "Save Changes", class: "btn btn-primary" %>
      <%= link_to "Cancel", profile_path, class: "btn btn-outline" %>
    </div>
  <% end %>
</div>
