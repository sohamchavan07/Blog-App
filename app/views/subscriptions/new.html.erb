<div class="max-w-2xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
  <div class="text-center">
    <h2 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">
      Upgrade to Premium
    </h2>
    <p class="mt-4 text-xl text-gray-600">
      Get access to exclusive deep dives, detailed guides, and premium-only content.
    </p>
  </div>

  <div class="mt-12 space-y-4 sm:mt-16 sm:space-y-0 sm:grid sm:grid-cols-2 sm:gap-6 lg:max-w-4xl lg:mx-auto xl:max-w-none xl:mx-0 xl:grid-cols-2">
    <!-- Monthly Plan -->
    <div class="border border-gray-200 rounded-lg shadow-sm divide-y divide-gray-200">
      <div class="p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Monthly</h3>
        <p class="mt-4 text-sm text-gray-500">The perfect way to support the blog monthly.</p>
        <p class="mt-8">
          <span class="text-4xl font-extrabold text-gray-900"><%= @plans[:monthly][:formatted_price] %></span>
          <span class="text-base font-medium text-gray-500">/mo</span>
        </p>
        <%= button_to "Subscribe Monthly", subscriptions_path(plan: "monthly"), data: { turbo: false }, class: "mt-8 block w-full bg-indigo-600 border border-transparent rounded-md py-2 text-sm font-semibold text-white text-center hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    </div>

    <!-- Yearly Plan -->
    <div class="border border-gray-200 rounded-lg shadow-sm divide-y divide-gray-200">
      <div class="p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900">Yearly</h3>
        <p class="mt-4 text-sm text-gray-500">Get two months free with an annual subscription.</p>
        <p class="mt-8">
          <span class="text-4xl font-extrabold text-gray-900"><%= @plans[:yearly][:formatted_price] %></span>
          <span class="text-base font-medium text-gray-500">/yr</span>
        </p>
        <%= button_to "Subscribe Yearly", subscriptions_path(plan: "yearly"), data: { turbo: false }, class: "mt-8 block w-full bg-indigo-600 border border-transparent rounded-md py-2 text-sm font-semibold text-white text-center hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    </div>
  </div>
</div>
