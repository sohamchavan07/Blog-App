<% title "Posts" %>

<div class="posts-index">
  <header class="posts-hero">
    <div class="posts-hero__content">
      <p class="posts-hero__eyebrow">The BlogApp Journal</p>
      <h1 class="posts-hero__title">Stories &amp; Ideas</h1>
      <p class="posts-hero__subtitle">Discover thoughtful writing from our community — tutorials, reflections, and everything in between.</p>
    </div>

    <%= form_with url: posts_path, method: :get, local: true, class: "posts-search" do |f| %>
      <div class="posts-search__field">
        <i data-lucide="search" class="posts-search__icon"></i>
        <%= f.text_field :query, value: params[:query], placeholder: "Search by title, keyword, or #tag...", class: "posts-search__input" %>
      </div>
      <%= f.submit "Search", class: "btn btn-primary posts-search__submit" %>
    <% end %>
  </header>

  <% if params[:query].present? %>
    <div class="posts-filter-bar">
      <i data-lucide="filter" class="posts-filter-bar__icon"></i>
      <span>Results for <strong>"<%= params[:query] %>"</strong></span>
      <%= link_to posts_path, class: "posts-filter-bar__clear" do %>
        <i data-lucide="x-circle"></i> Clear filter
      <% end %>
    </div>
  <% end %>

  <% if @posts.any? %>
    <% cache_key = ->(post) { [post, user_signed_in? && (current_user == post.user || current_user.admin?)] } %>

    <% if params[:query].blank? %>
      <%= render partial: "posts/post", object: @posts.first, locals: { featured: true } %>

      <% if @posts.size > 1 %>
        <div class="posts-section-label">
          <span>More articles</span>
        </div>
        <div class="posts-grid">
          <%= render partial: "posts/post", collection: @posts.drop(1), cached: cache_key %>
        </div>
      <% end %>
    <% else %>
      <div class="posts-grid posts-grid--search">
        <%= render partial: "posts/post", collection: @posts, cached: cache_key %>
      </div>
    <% end %>
  <% else %>
    <div class="posts-empty">
      <div class="posts-empty__icon">
        <i data-lucide="file-text"></i>
      </div>
      <h2 class="posts-empty__title">No posts found</h2>
      <p class="posts-empty__text">
        <% if params[:query].present? %>
          Nothing matched your search. Try different keywords or browse all posts.
        <% else %>
          The journal is waiting for its first story. Share something worth reading.
        <% end %>
      </p>
      <%= link_to new_post_path, class: "btn btn-primary posts-empty__cta" do %>
        <i data-lucide="pen-line"></i> Write the first post
      <% end %>
    </div>
  <% end %>

  <% if @pagy && @pagy.pages > 1 %>
    <nav class="posts-pagination" aria-label="Posts pagination">
      <%== pagy_bootstrap_nav(@pagy) %>
    </nav>
  <% end %>
</div>
