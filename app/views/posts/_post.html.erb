<%# partial for post card — pass featured: true for hero layout %>
<% featured = local_assigns.fetch(:featured, false) %>
<% can_manage = user_signed_in? && (current_user == post.user || current_user.admin?) %>

<article class="<%= featured ? 'post-featured' : 'post-card' %>">
  <% if post.cover_image.attached? %>
    <div class="<%= featured ? 'post-featured__media' : 'post-card__media' %>">
      <%= post_cover_tag post, link: true, class: featured ? 'post-featured__image' : 'post-card__image', alt: post.title %>
    </div>
  <% elsif featured %>
    <div class="post-featured__media post-featured__media--placeholder" aria-hidden="true">
      <i data-lucide="newspaper"></i>
    </div>
  <% end %>

  <div class="<%= featured ? 'post-featured__body' : 'post-card__body' %>">
    <% if featured %>
      <span class="post-featured__badge">Featured</span>
    <% end %>

    <% if post.tags.any? || (can_manage && post.tags.empty?) %>
      <div class="post-tags">
        <% post.tags.each do |tag| %>
          <%= link_to posts_path(query: "##{tag.name}"), class: "tag" do %>
            <i data-lucide="tag"></i><%= tag.name %>
          <% end %>
        <% end %>
        <% if can_manage %>
          <span class="tag <%= post.published? ? 'tag-published' : 'tag-draft' %>">
            <%= post.status&.capitalize || "Unknown" %>
          </span>
        <% end %>
      </div>
    <% end %>

    <%= link_to post.title, post, class: featured ? 'post-featured__title' : 'post-card__title' %>

    <p class="<%= featured ? 'post-featured__excerpt' : 'post-card__excerpt' %>">
      <%= truncate(post.plain_text_summary, length: featured ? 280 : 140) %>
    </p>

    <div class="post-author-row">
      <%= author_avatar_tag post.user, size: featured ? :lg : :sm %>
      <div class="post-author-row__info">
        <span class="post-author-row__name"><%= author_display_name(post.user) %></span>
        <div class="post-stats">
          <span class="post-stat"><i data-lucide="calendar"></i><%= time_ago_in_words(post.created_at) %> ago</span>
          <span class="post-stat"><i data-lucide="clock"></i><%= post.reading_time %> min</span>
          <% unless featured %>
            <span class="post-stat"><i data-lucide="eye"></i><%= number_with_delimiter(post.views_count) %></span>
          <% end %>
        </div>
      </div>
    </div>

    <% if featured %>
      <div class="post-featured__stats">
        <span class="post-stat"><i data-lucide="eye"></i><%= number_with_delimiter(post.views_count) %> views</span>
        <span class="post-stat"><i data-lucide="message-square"></i><%= post.comments_count %> comments</span>
      </div>
    <% end %>

    <div class="<%= featured ? 'post-featured__actions' : 'post-card__actions' %>">
      <%= link_to post, class: featured ? 'btn btn-primary post-featured__read' : 'post-card__read-link' do %>
        Read article <i data-lucide="arrow-right"></i>
      <% end %>

      <% if can_manage %>
        <div class="post-manage-actions">
          <%= link_to edit_post_path(post), class: "btn btn-outline btn-icon", title: "Edit post" do %>
            <i data-lucide="edit-3"></i>
          <% end %>
          <%= button_to post, method: :delete, data: { turbo_confirm: "Delete this post?" }, class: "btn btn-outline btn-danger btn-icon", title: "Delete post" do %>
            <i data-lucide="trash-2"></i>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</article>
